{
  "name": "sshweb",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based SSH client — an interactive web terminal and SFTP file access, over a WebSocket ↔ SSH bridge.",
  "//engines": "Minimum runtime we support, NOT a pin. `.nvmrc` (24) is the recommended dev/CI version; the app runs on Node 22+ (Next 16's floor), so keep this at the true minimum to avoid EBADENGINE warnings on 22.x deployments.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server.mjs",
    "dev:next": "next dev",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@next/env": "^16.2.12",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/xterm": "^5.5.0",
    "next": "^16.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.3",
    "ssh2": "^1.17.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.22",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "//overrides": "Force patched transitive deps that upstream still pins to vulnerable versions. Backward-compatible bumps; revisit when upstream ships them itself.",
  "overrides": {
    "postcss": "^8.5.22",
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.2.6",
    "nanoid": "^3.3.17",
    "js-yaml": "^5.2.3",
    "sharp": "^0.35.3"
  }
}
