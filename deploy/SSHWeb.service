# SSHWeb — systemd service unit (template)
#
# SSHWeb is NOT a plain Next.js app: the browser SSH terminal + SFTP browser
# are relayed through a custom Node server (`server.mjs`) that bridges a
# WebSocket to a real ssh2 connection. Because of that:
#
#   • The service MUST run the custom server — `node server.mjs`
#     (equivalently `npm run start`), NOT `next start`. `next start` boots a
#     plain Next server with no /api/ssh bridge, so the terminal never connects.
#   • A production build must exist first. Run `npm ci && npm run build` in the
#     WorkingDirectory before (re)starting this service — `server.mjs` serves
#     the prebuilt `.next/` output; without it the process exits immediately.
#
# Install:
#   1. Copy the app to WorkingDirectory below (e.g. /opt/sshweb) and build it:
#        cd /opt/sshweb && npm ci && npm run build
#   2. Edit the placeholders in this file (User/Group, WorkingDirectory, node
#      path, EnvironmentFile) to match your host.
#   3. sudo cp deploy/SSHWeb.service /etc/systemd/system/SSHWeb.service
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now SSHWeb
#
# See deploy/README.md for the full walkthrough.

[Unit]
Description=SSHWeb — browser-based SSH client + SFTP bridge
Documentation=https://github.com/Ruthgyeul/SSHWeb
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# --- Run as a dedicated, unprivileged service account (create it first):
#       sudo useradd --system --home /opt/sshweb --shell /usr/sbin/nologin sshweb
User=sshweb
Group=sshweb

# --- Where the built app lives. Adjust to your deploy path.
WorkingDirectory=/opt/sshweb

# --- Runtime configuration.
# server.mjs reads PORT (default 3000), NODE_ENV, and the SSH_* knobs. It also
# loads .env / .env.local from WorkingDirectory via @next/env, so you can keep
# configuration there instead of here if you prefer.
Environment=NODE_ENV=production
Environment=PORT=3000
# Optional: keep secrets / host settings (SSH_ALLOWED_HOSTS, SSH_MAX_SESSIONS,
# SSH_MAX_DOWNLOAD_MB, NEXT_PUBLIC_* …) in a root-owned env file (0640).
# The leading '-' makes the file optional so the unit still starts without it.
EnvironmentFile=-/etc/sshweb/sshweb.env

# --- Start the custom Next server + SSH bridge.
# Uses `env` so it resolves `node` from PATH (handy for nvm/asdf installs where
# node is not at /usr/bin/node). If you know the absolute path, use it directly,
# e.g. ExecStart=/usr/bin/node server.mjs
ExecStart=/usr/bin/env node server.mjs

# --- Restart policy: recover from crashes with a short backoff.
Restart=on-failure
RestartSec=2
# Give the SSH/WebSocket bridge time to drain on stop.
TimeoutStopSec=20

# --- Hardening. SSHWeb relays credentials to remote hosts and must never
# persist them locally, so lock the process down. Loosen a directive only if
# your deployment genuinely needs it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The app only needs to write nothing outside its build output at runtime; if
# your setup writes caches/logs under WorkingDirectory, add it to ReadWritePaths.
ReadWritePaths=/opt/sshweb/.next
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
