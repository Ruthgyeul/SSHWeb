# ============================================================================
# SSHWeb environment configuration
#
# Copy this file to `.env.local` and adjust the values for your deployment:
#
#     cp .env.example .env.local
#
# `.env*` files are gitignored (except this example), so real domains, tokens
# and secrets never get committed. Restart the server after editing.
#
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time and
# are therefore PUBLIC — never put a secret behind that prefix. Variables
# without the prefix are only ever read on the server.
#
# Every value below has a sensible default in src/config/siteConfig.ts (and
# server.mjs for the SSH bridge), so the app boots without a .env file.
# ============================================================================

# --- Server (server.mjs) ---------------------------------------------------
# Port the custom Node server listens on. Loaded from this file at startup, so
# you can pick the port here without touching any code. Defaults to 3000.
PORT=3000

# Interface to bind. Defaults to "127.0.0.1" (IPv4 loopback — matches a
# same-host reverse proxy). Set "0.0.0.0" to expose it on the network. Avoid
# "localhost", which can resolve to IPv6 ::1 only. Uncomment to override.
# HOSTNAME=0.0.0.0

# --- Site identity (src/config/siteConfig.ts) ------------------------------
# Canonical origin of the deployed site. Used for metadata, canonical URLs,
# robots.txt, sitemap.xml and absolute Open Graph image URLs. Set this to your
# real origin in production. No trailing slash needed — it is normalized in code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Full site name (browser tab default, Open Graph, structured data).
NEXT_PUBLIC_SITE_NAME=SSHWeb

# Short name (PWA home-screen label, title-bar suffix). Keep it under ~12 chars.
NEXT_PUBLIC_SITE_SHORT_NAME=SSHWeb

# One-line description for search engines and social cards.
NEXT_PUBLIC_SITE_DESCRIPTION=Connect to any SSH server from your browser — an interactive terminal and SFTP file access.

# Author / publisher shown in metadata and structured data.
NEXT_PUBLIC_AUTHOR_NAME=SSHWeb
NEXT_PUBLIC_AUTHOR_URL=http://localhost:3000

# Default content locale (e.g. en_US, ko_KR). Metadata only — sets <html lang>
# and the Open Graph locale for SEO/social cards. It does NOT translate the UI,
# which is English-only.
NEXT_PUBLIC_SITE_LOCALE=en_US

# --- Terminal prompt (cosmetic, src/config/siteConfig.ts) ------------------
# Shown in the shell prompt and window chrome, e.g. `user@sshweb:~$`.
NEXT_PUBLIC_TERMINAL_USER=user
NEXT_PUBLIC_TERMINAL_HOST=sshweb

# --- Search-engine indexing (src/app/robots.ts) ---------------------------
# "true"  → allow crawling (public production site)
# "false" → disallow all crawlers (staging / preview deploys)
NEXT_PUBLIC_ALLOW_INDEXING=true

# --- Web SSH client --------------------------------------------------------
# The web SSH client (/ssh) needs the custom Node server (`node server.mjs`,
# wired to `npm run dev` / `npm run start`) because a browser cannot open a raw
# SSH socket — server.mjs relays a WebSocket to a real ssh2 connection.

# Path the browser opens its SSH WebSocket on. Read by BOTH the client
# (NEXT_PUBLIC_*) and server.mjs — keep them identical if you change it.
NEXT_PUBLIC_SSH_WS_PATH=/api/ssh

# SERVER-ONLY host allowlist (comma/space separated). Empty = connect anywhere
# (like the reference client). Supports a leading "*." subdomain wildcard, e.g.
#   SSH_ALLOWED_HOSTS=example.com, *.internal.example.com
# Enforced in server.mjs; connections to other hosts are refused.
SSH_ALLOWED_HOSTS=

# Optional PUBLIC mirror of the allowlist, used only to reject a disallowed
# host in the browser with a friendly message before opening a socket. The
# server is the real gate, so this is purely a UX nicety — leave blank if unsure.
NEXT_PUBLIC_SSH_ALLOWED_HOSTS=

# Largest natively playable video/audio clip (in MB) that the browser fetches
# whole and keeps in its in-memory preview cache (default 24). Larger clips use
# the seekable HTTP Range stream instead. Decimal values are accepted; set 0 to
# disable whole-file media caching and stream every eligible clip. Because this
# is NEXT_PUBLIC_*, the value is embedded at build time and is not a secret.
NEXT_PUBLIC_SSH_MEDIA_CACHE_MAX_MB=24

# SSRF guard: when "true", refuse to dial private/internal targets — loopback,
# the RFC1918 private ranges (10/8, 172.16/12, 192.168/16), link-local
# (169.254/16, including the 169.254.169.254 cloud-metadata endpoint), IPv6
# loopback/ULA/link-local, and the "localhost" name — so the bridge can't be
# used to reach a cloud metadata service or internal hosts. Off by default so a
# self-hosted deploy can still reach its own LAN; turn it ON for a public relay.
# IP literals and "localhost" are matched synchronously, and hostnames are also
# resolved at dial time (DNS) and refused if any resolved address is private, so
# a name pointing at an internal IP is caught too. Pair with SSH_ALLOWED_HOSTS
# for a tight gate.
SSH_BLOCK_PRIVATE_HOSTS=false

# Max concurrent SSH sessions this server process will hold (default 25).
SSH_MAX_SESSIONS=25

# Max single-file SFTP download size in MB (default 25). Set 0 to disable the
# limit (unlimited).
SSH_MAX_DOWNLOAD_MB=25

# Max single-file SFTP upload size in MB (default 25). A write that would exceed
# this is aborted. Set 0 to disable the limit (unlimited).
SSH_MAX_UPLOAD_MB=25

# Size (MB) of the in-memory grid-thumbnail cache on the bridge (default 128).
# Finished WebP tiles are cached process-wide, keyed by identity + path +
# size:mtime, so a re-visited folder or a re-login reuses them with no SSH read
# and no transcode (nothing is written to disk). Set 0 to disable caching.
SSH_THUMB_CACHE_MB=128

# Time-to-live (ms) for a cached thumbnail tile (default 1800000 = 30 min). A
# tile unused for this long is dropped, so the bridge doesn't keep a decoded copy
# of your files in shared process memory indefinitely — a confidentiality knob
# for a multi-tenant deploy. A re-login within the window still reuses tiles for
# free. Set 0 to never expire (only LRU eviction, the settings "Clear thumbnail
# cache" action, or a restart clear the cache).
SSH_THUMB_CACHE_TTL_MS=1800000

# Image-preview transcode format (click-to-view). The bridge downscales a photo
# to fit the preview box and re-encodes it so click-to-view loads in KB, not MB
# — pixel-perfect detail is always available on demand (zoom / "Original" /
# Download all fetch the untouched original). Choose the size/speed/fidelity
# trade-off:
#   webp-lossy    (default) — fastest to open, smallest encode CPU, visually
#                   indistinguishable at the preview resolution.
#   webp-lossless — pixel-exact but larger on the wire and slower to encode.
#   avif          — smallest wire size at a given quality, but the slowest CPU
#                   encode (previews aren't cached, so it's a real first-open cost).
SSH_PREVIEW_IMAGE_FORMAT=webp-lossy

# Quality (1–100) for the lossy WebP / AVIF preview (default 92). Higher = better
# fidelity + larger/slower; ignored for webp-lossless (always pixel-exact).
SSH_PREVIEW_IMAGE_QUALITY=92

# Max concurrent on-the-fly video transcodes (default 3; 0 disables the feature).
# Videos in a container/codec the browser can't play natively (e.g. .avi, .wmv,
# .flv, .mts) are converted to fragmented MP4 with ffmpeg and streamed as they
# convert. It's CPU-heavy, so only this many run at once (extra requests get a
# 503); each is killed when the viewer navigates away. Requires ffmpeg.
SSH_MAX_TRANSCODES=3

# Concurrency caps for expensive, client-triggered work, so a burst can't
# exhaust the shared bridge process. Grid thumbnails each read a whole file and
# run sharp/ffmpeg; recursive find/grep searches walk the tree (grep scans file
# contents). Only this many of each run at once (process-wide); the rest queue,
# and once a queue is full the extra work is shed (a skipped thumbnail keeps its
# type icon; a search returns an empty, truncated result). Defaults shown.
SSH_MAX_THUMBNAIL_JOBS=4
SSH_MAX_THUMBNAIL_QUEUE=500
SSH_MAX_SEARCH_JOBS=4
SSH_MAX_SEARCH_QUEUE=100

# Per-IP throttle on SSH connection attempts, to stop the bridge from being used
# as a brute-force relay. Up to SSH_RATE_LIMIT_MAX attempts are allowed per
# SSH_RATE_LIMIT_WINDOW_MS window (defaults: 10 attempts / 60000 ms). The same
# limit independently throttles access-key guesses at POST /api/access. Set MAX
# to 0 to disable throttling.
SSH_RATE_LIMIT_MAX=10
SSH_RATE_LIMIT_WINDOW_MS=60000

# Overall SSH handshake timeout in ms (default 60000). This bounds the whole
# handshake — including the time spent waiting for the user to accept a host key
# (trust-on-first-use) or enter a 2FA / keyboard-interactive code — so a browser
# that opens a prompt and never answers can't hold a session slot open. Applied
# both as ssh2's readyTimeout and as an independent reaper on the pending prompt.
# Raise it if users need longer to fetch a 2FA code; 0 disables the independent
# reaper and keeps ssh2's default.
SSH_HANDSHAKE_TIMEOUT_MS=60000

# How long (ms) an upgraded WebSocket may sit without sending its `connect`
# message before the bridge reclaims the socket (default 30000). Guards against
# idle half-open connections that never start an SSH session.
SSH_CONNECT_GRACE_MS=30000

# Trust the X-Forwarded-For header when resolving the client IP for the rate
# limiter. Keep "true" behind a reverse proxy (the default deployment); set
# "false" if the server is exposed directly, so the header can't be spoofed.
SSH_TRUST_PROXY=true

# Number of chained trusted proxies in front of the bridge. The client IP is
# read this many hops in from the RIGHT of X-Forwarded-For — the right-most hop
# is the address your own proxy appended (unspoofable), while the left-most is
# attacker-controlled. Default 1 (a single reverse proxy). Increase only if you
# run N trusted proxies in series; setting it too high would trust a hop the
# client can forge. Only used when SSH_TRUST_PROXY=true.
SSH_TRUSTED_PROXY_HOPS=1

# WebSocket origin allowlist (comma/space separated), guarding against
# cross-site WebSocket hijacking. Empty (default) requires the handshake's
# Origin to match the request Host (same-origin). Set explicit origins only if
# the page is served from a different origin than the bridge, e.g.
#   SSH_ALLOWED_ORIGINS=https://sshweb.example.com
SSH_ALLOWED_ORIGINS=

# Auto-close a session after this many milliseconds with no shell/SFTP activity
# (latency pings don't count, so a truly idle terminal still times out). Good
# hygiene for a shared/public deploy so abandoned sessions don't linger. 0 (the
# default) disables the idle timeout. Example: 900000 = 15 minutes.
SSH_IDLE_TIMEOUT_MS=0

# Operational logging for the SSH bridge (stdout). "json" (default) emits one
# structured line per event — server-start, ws-open/ws-close, connect, reject
# (with a reason), idle-timeout, shutdown — carrying only
# non-sensitive fields (client IP, host, port). Credentials are NEVER logged.
# Set "off" to silence event logs.
SSH_LOG=json

# Optional shared secret that gates the whole relay. When set, the browser must
# exchange it for an HttpOnly access cookie at POST /api/access before its SSH
# WebSocket upgrade is accepted (the UI shows a one-time "access key" prompt).
# The raw token is never stored in the cookie (a SHA-256 digest is) and is never
# logged; the exchange compares in constant time and is per-IP rate-limited
# against brute force. Leave blank (the default) to keep the relay open, like the
# reference client. Use this for a small/shared public deploy where you don't
# want just anyone driving the bridge. Example: SSH_ACCESS_TOKEN=a-long-random-string
SSH_ACCESS_TOKEN=

# Elevated (sudo) file access. When "true", the file browser gains a "sudo"
# toggle that routes every SFTP operation through an `sftp-server` running as
# root (`sudo sftp-server` over an exec channel) — the SFTP counterpart to
# `sudo su` in the terminal, so files the login user can't reach become
# browsable/editable. This is a broad grant, so it's OFF by default; the target
# host's sudoers policy still decides whether elevation actually succeeds. The
# UI asks for an optional sudo password (fed to `sudo -S`); leave it blank when
# passwordless sudo (a NOPASSWD rule for sftp-server) is configured — that path
# uses `sudo -n` and fails fast instead of hanging on a prompt.
SSH_ALLOW_SUDO=false

# Optional override of where to look for `sftp-server` on the target when
# elevating (comma/space separated, tried in order). Empty (default) uses a
# built-in cross-distro list (Debian/Ubuntu, RHEL/Fedora, Arch/Alpine, BSD).
# Example: SSH_SFTP_SERVER_PATHS=/usr/lib/openssh/sftp-server
SSH_SFTP_SERVER_PATHS=

# A dependency-free JSON health probe is always served at GET /api/health,
# reporting { status, activeSessions, maxSessions, totalConnections,
# rejectedConnections, errors { sshErrors, rejections }, bytesUp, bytesDown,
# sftp { filesUp, bytesUp, filesDown, bytesDown }, thumbnails { served, skipped,
# bytesOut, cacheHits, cacheEntries, cacheBytes }, transcodes { active, max },
# limits { thumbnails, search }, uptime } for load balancers, uptime checks and
# ops dashboards. It returns 503 with status "shutting_down" during a graceful
# shutdown (SIGTERM/SIGINT drain active sessions before exit). No config needed.
