# ============================================================================
# SSHWeb environment configuration
#
# Copy this file to `.env.local` and adjust the values for your deployment:
#
#     cp .env.example .env.local
#
# `.env*` files are gitignored (except this example), so real domains, tokens
# and secrets never get committed. Restart the server after editing.
#
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time and
# are therefore PUBLIC — never put a secret behind that prefix. Variables
# without the prefix are only ever read on the server.
#
# Every value below has a sensible default in src/config/siteConfig.ts (and
# server.mjs for the SSH bridge), so the app boots without a .env file.
# ============================================================================

# --- Server (server.mjs) ---------------------------------------------------
# Port the custom Node server listens on. Loaded from this file at startup, so
# you can pick the port here without touching any code. Defaults to 3000.
PORT=3000

# Interface to bind. Defaults to "127.0.0.1" (IPv4 loopback — matches a
# same-host reverse proxy). Set "0.0.0.0" to expose it on the network. Avoid
# "localhost", which can resolve to IPv6 ::1 only. Uncomment to override.
# HOSTNAME=0.0.0.0

# --- Site identity (src/config/siteConfig.ts) ------------------------------
# Canonical origin of the deployed site. Used for metadata, canonical URLs,
# robots.txt, sitemap.xml and absolute Open Graph image URLs. Set this to your
# real origin in production. No trailing slash needed — it is normalized in code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Full site name (browser tab default, Open Graph, structured data).
NEXT_PUBLIC_SITE_NAME=SSHWeb

# Short name (PWA home-screen label, title-bar suffix). Keep it under ~12 chars.
NEXT_PUBLIC_SITE_SHORT_NAME=SSHWeb

# One-line description for search engines and social cards.
NEXT_PUBLIC_SITE_DESCRIPTION=Connect to any SSH server from your browser — an interactive terminal and SFTP file access.

# Author / publisher shown in metadata and structured data.
NEXT_PUBLIC_AUTHOR_NAME=SSHWeb
NEXT_PUBLIC_AUTHOR_URL=http://localhost:3000

# Default content locale (BCP-47). Affects <html lang> and Open Graph locale.
NEXT_PUBLIC_SITE_LOCALE=en_US

# --- Terminal prompt (cosmetic, src/config/siteConfig.ts) ------------------
# Shown in the shell prompt and window chrome, e.g. `user@sshweb:~$`.
NEXT_PUBLIC_TERMINAL_USER=user
NEXT_PUBLIC_TERMINAL_HOST=sshweb

# --- Search-engine indexing (src/app/robots.ts) ---------------------------
# "true"  → allow crawling (public production site)
# "false" → disallow all crawlers (staging / preview deploys)
NEXT_PUBLIC_ALLOW_INDEXING=true

# --- Web SSH client --------------------------------------------------------
# The web SSH client (/ssh) needs the custom Node server (`node server.mjs`,
# wired to `npm run dev` / `npm run start`) because a browser cannot open a raw
# SSH socket — server.mjs relays a WebSocket to a real ssh2 connection.

# Path the browser opens its SSH WebSocket on. Read by BOTH the client
# (NEXT_PUBLIC_*) and server.mjs — keep them identical if you change it.
NEXT_PUBLIC_SSH_WS_PATH=/api/ssh

# SERVER-ONLY host allowlist (comma/space separated). Empty = connect anywhere
# (like the reference client). Supports a leading "*." subdomain wildcard, e.g.
#   SSH_ALLOWED_HOSTS=example.com, *.internal.example.com
# Enforced in server.mjs; connections to other hosts are refused.
SSH_ALLOWED_HOSTS=

# Optional PUBLIC mirror of the allowlist, used only to reject a disallowed
# host in the browser with a friendly message before opening a socket. The
# server is the real gate, so this is purely a UX nicety — leave blank if unsure.
NEXT_PUBLIC_SSH_ALLOWED_HOSTS=

# Max concurrent SSH sessions this server process will hold (default 25).
SSH_MAX_SESSIONS=25

# Max single-file SFTP download size in bytes (default 26214400 = 25 MB).
SSH_MAX_DOWNLOAD_BYTES=26214400

# Max single-file SFTP upload size in bytes (default 26214400 = 25 MB). A write
# that would exceed this is aborted. Set 0 to disable the limit.
SSH_MAX_UPLOAD_BYTES=26214400

# Per-IP throttle on SSH connection attempts, to stop the bridge from being used
# as a brute-force relay. Up to SSH_RATE_LIMIT_MAX attempts are allowed per
# SSH_RATE_LIMIT_WINDOW_MS window (defaults: 10 attempts / 60000 ms). Set MAX
# to 0 to disable throttling.
SSH_RATE_LIMIT_MAX=10
SSH_RATE_LIMIT_WINDOW_MS=60000

# Trust the X-Forwarded-For header when resolving the client IP for the rate
# limiter. Keep "true" behind a reverse proxy (the default deployment); set
# "false" if the server is exposed directly, so the header can't be spoofed.
SSH_TRUST_PROXY=true

# WebSocket origin allowlist (comma/space separated), guarding against
# cross-site WebSocket hijacking. Empty (default) requires the handshake's
# Origin to match the request Host (same-origin). Set explicit origins only if
# the page is served from a different origin than the bridge, e.g.
#   SSH_ALLOWED_ORIGINS=https://sshweb.example.com
SSH_ALLOWED_ORIGINS=

# Auto-close a session after this many milliseconds with no shell/SFTP activity
# (latency pings don't count, so a truly idle terminal still times out). Good
# hygiene for a shared/public deploy so abandoned sessions don't linger. 0 (the
# default) disables the idle timeout. Example: 900000 = 15 minutes.
SSH_IDLE_TIMEOUT_MS=0

# Operational logging for the SSH bridge (stdout). "json" (default) emits one
# structured line per event — server-start, ws-open/ws-close, connect, reject
# (with a reason), idle-timeout — carrying only non-sensitive fields (client IP,
# host, port). Credentials are NEVER logged. Set "off" to silence event logs.
SSH_LOG=json

# A dependency-free JSON health probe is always served at GET /api/health,
# reporting { status, activeSessions, maxSessions, uptime } for load balancers
# and uptime checks. No configuration needed.
